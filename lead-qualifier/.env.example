# ── AI provider ──────────────────────────────────────────────────────────────
# Which AI to use: anthropic (Claude) | gemini (free) | groq (free) | openai
LLM_PROVIDER=gemini

# Provide the key for the provider you chose above (only one is needed).
# Free keys:  Gemini → aistudio.google.com   ·   Groq → console.groq.com
GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Or one generic key, used if the provider-specific var above is empty:
# LLM_API_KEY=

# ── Optional model / behaviour overrides ─────────────────────────────────────
# Leave LLM_MODEL blank to use a sensible default per provider:
#   anthropic → claude-opus-4-8        gemini → gemini-2.0-flash
#   groq      → llama-3.3-70b-versatile  openai → gpt-4o-mini
# LLM_MODEL=
# Advanced: override the OpenAI-compatible endpoint (rarely needed).
# LLM_BASE_URL=

# Qualification threshold on the 1–10 scale. Leads scoring >= this qualify.
SCORE_THRESHOLD=6
# Polite delay (seconds) between web requests to the same host.
REQUEST_DELAY=1.0
# Max worker threads for processing companies in parallel.
# Tip: free AI tiers rate-limit — set 2 if you hit "rate limit" errors.
MAX_WORKERS=4

# ── Optional: paid historical-jobs provider (only for retroactive 6-mo history)
# Current openings work fully WITHOUT this. Only set if --history-provider=api.
THEIRSTACK_API_KEY=

# ── Optional: hosted scraping service for JS-heavy sites ──────────────────────
# Plain Playwright requires no key; only set this if you wire in a paid fetcher.
SCRAPER_API_KEY=
