# ── Required ───────────────────────────────────────────────────────────────
# Anthropic API key — used for qualification scoring + brief/email generation.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Optional model / behaviour overrides ─────────────────────────────────────
# Any current Claude model id. Defaults to claude-opus-4-8 (most capable).
# High volume? Switch to claude-sonnet-4-6 or claude-haiku-4-5 to cut cost.
ANTHROPIC_MODEL=claude-opus-4-8
# Qualification threshold on the 1–10 scale. Leads scoring >= this qualify.
SCORE_THRESHOLD=6
# Polite delay (seconds) between web requests to the same host.
REQUEST_DELAY=1.0
# Max worker threads for processing companies in parallel.
MAX_WORKERS=4

# ── Optional: paid historical-jobs provider (only for retroactive 6-mo history)
# Current openings work fully WITHOUT this. Only set if --history-provider=api.
THEIRSTACK_API_KEY=

# ── Optional: hosted scraping service for JS-heavy sites ──────────────────────
# Plain Playwright requires no key; only set this if you wire in a paid fetcher.
SCRAPER_API_KEY=
